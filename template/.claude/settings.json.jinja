{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "KILN_PROJECT": "{{ name }}",
    "KILN_BACKEND_DIR": "{{ 'backend' if backend != 'none' else '' }}",
    "KILN_FRONTEND_DIR": "{{ 'frontend' if frontend != 'none' else '' }}",
    "KILN_TEST_ENV": "{{ 'backend/.env' if backend in ['django', 'fastapi'] else '' }}"
  },
{#- kiln's marketplace, on GitHub (public repository), at `main`, the state of its latest release:
    Claude Code offers it with its plugins to whoever opens the repo, then updates them in the
    background at each launch (autoUpdate, off by default for a third-party marketplace). A
    "kiln" marketplace already installed from a local directory keeps its source. #}
  "extraKnownMarketplaces": {
    "kiln": {
      "source": {
        "source": "github",
        "repo": "antoine-tena/kiln",
        "ref": "main"
      },
      "autoUpdate": true
    }
  },
{%- set plugins = ['kiln@kiln'] + (['django@kiln'] if backend == 'django' else []) + (['nuxt@kiln'] if frontend == 'nuxt' else []) + (['serena@kiln'] if serena else []) %}
  "enabledPlugins": {
{%- for plugin in plugins %}
    "{{ plugin }}": true{{ "," if not loop.last }}
{%- endfor %}
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)"
{%- if backend == 'java' %},
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)"
{%- endif %}
    ]
  }
}
